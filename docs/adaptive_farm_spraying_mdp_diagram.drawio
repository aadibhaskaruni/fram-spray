<mxfile host="app.diagrams.net" modified="2026-11-04T10:21:00.000Z" agent="Manus" version="24.7.17" type="device">
  <diagram id="project-mdp-loop" name="Project MDP Diagram">
    <mxGraphModel dx="1100" dy="650" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="680" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="PROJECT MDP / POMDP INTERACTION LOOP" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Georgia;fontSize=28;fontStyle=1;fontColor=#A4123F;" vertex="1" parent="1"><mxGeometry x="160" y="28" width="880" height="45" as="geometry"/></mxCell>
        <mxCell id="agent" value="&lt;b&gt;AGENT&lt;/b&gt;&lt;br&gt;PPO / DQN / baseline policy&lt;br&gt;&lt;br&gt;Receives observation o&lt;sub&gt;t&lt;/sub&gt;&lt;br&gt;Chooses action a&lt;sub&gt;t&lt;/sub&gt; ∈ {0, 1, 2, 3}&lt;br&gt;Dose u&lt;sub&gt;t&lt;/sub&gt; ∈ {0, ⅓, ⅔, 1}&lt;br&gt;None · Low · Medium · High" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B8114F;strokeWidth=3;fontColor=#222222;fontFamily=Arial;fontSize=20;align=center;verticalAlign=middle;spacing=18;" vertex="1" parent="1"><mxGeometry x="75" y="230" width="380" height="250" as="geometry"/></mxCell>
        <mxCell id="environment" value="&lt;b&gt;FARM ENVIRONMENT&lt;/b&gt;&lt;br&gt;8 × 8 field · 3 sweeps · 192 decisions&lt;br&gt;&lt;br&gt;Hidden state s&lt;sub&gt;t&lt;/sub&gt;: infection p, crop health h, residue, weather, tank, position, time.&lt;br&gt;&lt;br&gt;Transition: apply dose at current cell, then update infection, health, residue, tank and time.&lt;br&gt;&lt;br&gt;Spray effect: p ← p · exp(−3u&lt;sub&gt;t&lt;/sub&gt;)&lt;br&gt;Spray blocked if wind &gt; 20 km/h, rain &gt; 0.2 mm, or tank is insufficient." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FBEAF0;strokeColor=#A4123F;strokeWidth=2;fontColor=#222222;fontFamily=Arial;fontSize=18;align=center;verticalAlign=middle;spacing=18;" vertex="1" parent="1"><mxGeometry x="745" y="195" width="390" height="320" as="geometry"/></mxCell>
        <mxCell id="observation" value="&lt;b&gt;OBSERVATION o&lt;sub&gt;t&lt;/sub&gt;&lt;/b&gt;&lt;br&gt;Noisy local sensor scores + cell health and weather/tank/position features.&lt;br&gt;13 features × 4-step history = 52 inputs.&lt;br&gt;&lt;br&gt;The agent does not observe the complete true infection/residue maps." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FBEAF0;strokeColor=#A4123F;strokeWidth=2;fontColor=#222222;fontFamily=Arial;fontSize=17;align=center;verticalAlign=middle;spacing=16;" vertex="1" parent="1"><mxGeometry x="325" y="85" width="430" height="115" as="geometry"/></mxCell>
        <mxCell id="reward" value="&lt;b&gt;REWARD r&lt;sub&gt;t&lt;/sub&gt;&lt;/b&gt;&lt;br&gt;r = 1.0·ΔH − 0.10C − 0.15U − 0.15E&lt;br&gt;Health change − chemical dose − unnecessary spray − wind drift&lt;br&gt;&lt;br&gt;PPO shaping weight 0.3: training only. Evaluation uses base reward." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FBEAF0;strokeColor=#9A1345;strokeWidth=2;fontColor=#222222;fontFamily=Arial;fontSize=17;align=center;verticalAlign=middle;spacing=16;" vertex="1" parent="1"><mxGeometry x="325" y="545" width="600" height="110" as="geometry"/></mxCell>
        <mxCell id="e_action" value="action a_t / dose u_t" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9A1345;strokeWidth=3;fontColor=#64102D;fontSize=16;endArrow=block;endFill=1;exitX=1;exitY=0.55;entryX=0;entryY=0.55;" edge="1" parent="1" source="agent" target="environment"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_observation" value="next observation o_(t+1)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#A4123F;strokeWidth=3;fontColor=#64102D;fontSize=16;endArrow=block;endFill=1;exitX=0.1;exitY=0;entryX=0.85;entryY=1;" edge="1" parent="1" source="environment" target="observation"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="785" y="135"/><mxPoint x="545" y="135"/></Array></mxGeometry></mxCell>
        <mxCell id="e_to_agent" value="observation o_t" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#A4123F;strokeWidth=3;fontColor=#64102D;fontSize=16;endArrow=block;endFill=1;exitX=0;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="observation" target="agent"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="265" y="142"/><mxPoint x="265" y="215"/></Array></mxGeometry></mxCell>
        <mxCell id="e_reward" value="reward r_t" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9A1345;strokeWidth=2;dashed=1;fontColor=#64102D;fontSize=15;endArrow=block;endFill=1;exitX=0.3;exitY=1;entryX=0.65;entryY=1;" edge="1" parent="1" source="environment" target="reward"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="860" y="565"/><mxPoint x="720" y="565"/></Array></mxGeometry></mxCell>
        <mxCell id="e_feedback" value="reward feedback to agent" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9A1345;strokeWidth=2;dashed=1;fontColor=#64102D;fontSize=15;endArrow=block;endFill=1;exitX=0;exitY=0.5;entryX=0.5;entryY=1;" edge="1" parent="1" source="reward" target="agent"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="265" y="600"/><mxPoint x="265" y="500"/></Array></mxGeometry></mxCell>
        <mxCell id="foot" value="POMDP: the agent uses partial, noisy observations rather than the true full field state. Crop/pest transition dynamics are simulator assumptions." style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Arial;fontSize=14;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="120" y="660" width="960" height="20" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
